<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.cheneyzhang93</groupId>
    <artifactId>bellringer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>bellringer-spring-boot-starter</artifactId>
  <name>bellringer-spring-boot-starter</name>
  <description>Spring Boot 2.7 自动装配（Java 8 兼容）：事件源采集与告警出口</description>

  <dependencies>
    <dependency>
      <groupId>io.github.cheneyzhang93</groupId>
      <artifactId>bellringer-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- 上报序列化：Web 应用天然在 classpath；纯后台应用若不引入，mode 含 http 时启动即报错 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 多实例 Redis 去重（observability.dedup.redis=true 时才需要），宿主自备连接配置 -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>io/github/cheneyzhang93/bellringer/starter/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>io/github/cheneyzhang93/bellringer/starter/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
